---
import '../styles/global.css';
import { href } from '../lib/content';
import LegacyRedirect from '../components/LegacyRedirect.astro';
interface Props { title?: string; description?: string; image?: string; article?: boolean; date?: string; noindex?: boolean; }
const { title, description = 'Machine learning, computer graphics and tools. Projects and notes by Paweł Kowalski.', image, article = false, date, noindex = false } = Astro.props;
const fullTitle = title ? `${title} · Paweł Kowalski` : 'Paweł Kowalski · Machine learning & computer graphics';
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = image ? new URL(href(image), Astro.site).href : undefined;
const active = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#111312" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <title>{fullTitle}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Paweł Kowalski" href={href('/rss.xml')} />
    <meta property="og:title" content={title || 'Paweł Kowalski'} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Paweł Kowalski" />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {date && <meta property="article:published_time" content={date} />}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    <LegacyRedirect />
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="site-header shell">
      <a class="wordmark" href={href('/')} aria-label="Paweł Kowalski — home">pk<span>_</span><span class="wordmark-domain"> / kowalski</span></a>
      <nav aria-label="Main navigation">
        <a href={href('/archive/')} aria-current={active.startsWith(href('/archive/')) ? 'page' : undefined}>Work & notes</a>
        <a href={href('/about-us/')} aria-current={active.startsWith(href('/about-us/')) ? 'page' : undefined}>About</a>
        <a href={href('/contact/')} aria-current={active.startsWith(href('/contact/')) ? 'page' : undefined}>Contact <span aria-hidden="true">↗</span></a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer shell">
      <a class="footer-name" href={href('/')}>Paweł Kowalski<span class="accent">.</span></a>
      <p>Machine learning / Computer graphics / Tools</p>
      <div class="footer-links">
        <a href="https://github.com/p4vv37">GitHub <span aria-hidden="true">↗</span></a>
        <a href={href('/rss.xml')}>RSS</a>
        <a href="mailto:contact@pkowalski.com">Email <span aria-hidden="true">↗</span></a>
      </div>
    </footer>
  </body>
</html>
