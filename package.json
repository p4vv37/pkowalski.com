{
  "name": "pkowalski.com",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build && node scripts/preserve-media-urls.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "verify": "node scripts/verify-build.mjs",
    "check:secrets": "bash scripts/check-secrets.sh",
    "new:post": "node scripts/new-post.mjs",
    "test": "node --test --test-isolation=none tests/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@wordpress/autop": "^5.0.0",
    "astro": "^7.4.2",
    "linkedom": "^0.18.14"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "typescript": "^6.0.3"
  }
}
